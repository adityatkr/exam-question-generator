# Secrets -- never commit real API keys
.streamlit/secrets.toml
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Test / run artefacts -- logs are noise, but the result files are the
# evidence behind tests/test_cases.md and prompts/iteration_log.md, so they
# are tracked deliberately.
tests/output/*
!tests/output/results.json
!tests/output/results_table.md
!tests/output/iterations.json
samples/*.tmp
exports/
.pytest_cache/

